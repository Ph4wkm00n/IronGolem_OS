# Gateway-only image for v0.1.
# Step 7 of the v0.1 plan parked the other six services under
# services/_deferred/; they will be reintroduced in v0.2 once their behavior
# is wired into the gateway's runtime client.
FROM golang:1.22-alpine AS builder

WORKDIR /app
COPY services/go.mod services/go.sum* ./
RUN go mod download || true

COPY services/ .

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/irongolem-gateway ./gateway/cmd

FROM alpine:3.19
RUN apk add --no-cache ca-certificates
COPY --from=builder /bin/irongolem-* /usr/local/bin/

EXPOSE 8080
CMD ["irongolem-gateway"]
